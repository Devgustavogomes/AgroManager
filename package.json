{
  "name": "agromanager-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "compose:up": "docker compose -f ./docker-compose.yml up",
    "compose:build": "docker compose -f ./docker-compose.yml up --build",
    "compose:stop": "docker compose -f ./docker-compose.yml stop",
    "compose:start": "docker compose -f ./docker-compose.yml start",
    "compose:down": "docker compose -f ./docker-compose.yml down",
    "compose:dev:up": "docker compose -f ./docker-compose.dev.yml up",
    "compose:dev:build": "docker compose -f ./docker-compose.dev.yml up --build",
    "compose:dev:stop": "docker compose -f ./docker-compose.dev.yml stop",
    "compose:dev:start": "docker compose -f ./docker-compose.dev.yml start",
    "compose:dev:down": "docker compose -f ./docker-compose.dev.yml down",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "migrate": "pnpm --filter api run migrate:dev",
    "setup:env": "node -e \"const f=require('fs');['apps/api','apps/web','apps/workers'].forEach(d=>['development','test','production'].forEach(e=>{const t=d+'/.env.'+e;if(!f.existsSync(t))f.copyFileSync(d+'/.env.example',t)}))\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "turbo": "^2.11.10"
  },
  "lint-staged": {
    "apps/api/**/*.{ts,tsx}": [
      "eslint --fix",
      "pnpm --filter api run test -- --changed"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "apps/workers/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
